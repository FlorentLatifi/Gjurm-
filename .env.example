# Local development settings for `docker compose` (repo root). Copy to .env; never commit .env.
# Every variable and its default is documented in backend/src/gjurme/config.py.
# Production uses deploy/.env.example instead.

# fake = deterministic heuristics, no API key, no cost (default).
# anthropic = real enrichment; set ANTHROPIC_API_KEY and keep the budget small.
LLM_PROVIDER=fake
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5
# LLM_DAILY_BUDGET_USD=0.50

# POSTGRES_PASSWORD=gjurme
# LOG_FORMAT=text
# SCHEDULER_INTERVAL_MINUTES=15
# ALERT_WEBHOOK_URL=
