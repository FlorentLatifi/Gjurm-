# /opt/gjurme/.env — production configuration. chmod 600. NEVER commit the real file.
# Every variable is documented in backend/src/gjurme/config.py; this lists the ones to set.

# --- deployment ----------------------------------------------------------------------------
DOMAIN=gjurme.example.com                 # DNS A/AAAA record must point at the server
ACME_EMAIL=you@example.com                # Let's Encrypt account e-mail
IMAGE_TAG=                                # set by deploy.sh (git SHA); leave empty here
# IMAGE_REGISTRY=ghcr.io/florentlatifi/gjurme

# --- secrets (generate: openssl rand -base64 36) -------------------------------------------
POSTGRES_PASSWORD=change-me-long-random
ADMIN_API_TOKEN=change-me-at-least-32-characters-random
ANTHROPIC_API_KEY=                        # sk-ant-...  (enrichment is skipped until set)

# --- LLM cost controls ---------------------------------------------------------------------
LLM_MODEL=claude-sonnet-5
LLM_DAILY_BUDGET_USD=2.00                 # hard daily cap; enrichment pauses when reached
ENRICH_MAX_PER_RUN=150
ENRICH_CONCURRENCY=4

# --- alerting ------------------------------------------------------------------------------
ALERT_WEBHOOK_URL=                        # Slack/Discord webhook or https://ntfy.sh/<topic>
ALERT_WEBHOOK_FORMAT=generic              # slack | discord | ntfy | generic

# --- pipeline ------------------------------------------------------------------------------
SCHEDULER_INTERVAL_MINUTES=15
LOG_LEVEL=INFO

# --- backups -------------------------------------------------------------------------------
BACKUP_DIR=/opt/gjurme/backups
BACKUP_HOUR_UTC=2
RETAIN_DAILY=7
RETAIN_WEEKLY=4
# RCLONE_REMOTE=b2:gjurme-backups        # with --profile offsite and ./rclone/rclone.conf
