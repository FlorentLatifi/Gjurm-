# /opt/gjurme/.env — production configuration. chmod 600. NEVER commit the real file.
# Every variable is documented in backend/src/gjurme/config.py; this lists the ones to set.
# Comments go on their own lines: Docker Compose reads "KEY=   # note" as the value "# note".

# --- deployment ----------------------------------------------------------------------------
# or a free subdomain, e.g. gjurme.duckdns.org
DOMAIN=gjurme.example.com
# Let's Encrypt account e-mail
ACME_EMAIL=you@example.com
# leave empty: deploy.sh sets it (.deploy-state/running is the release that is up)
IMAGE_TAG=
# IMAGE_REGISTRY=ghcr.io/florentlatifi/gjurme  # multi-arch (amd64 + arm64)

# --- secrets (generate: openssl rand -base64 36) -------------------------------------------
POSTGRES_PASSWORD=change-me-long-random
ADMIN_API_TOKEN=change-me-at-least-32-characters-random

# --- analysis mode -------------------------------------------------------------------------
# Free mode ($0, no API key): topics, tone and names from keyword rules. Much less accurate; the
# site says so in a banner and on every article page. ("fake" is the internal provider name.)
LLM_PROVIDER=fake
ALLOW_FAKE_LLM_IN_PRODUCTION=true
# AI mode (Claude): comment out the two lines above, set the key below, restart the scheduler and
# re-analyse what the rules did (within the daily budget):
#   ./deploy.sh "$(cat .deploy-state/current)"      # restarts the containers with the new .env
#   IMAGE_TAG=$(cat .deploy-state/running) docker compose -f docker-compose.prod.yml \
#     exec scheduler gjurme enrich-requeue --provider fake
# LLM_PROVIDER=anthropic
# sk-ant-...
ANTHROPIC_API_KEY=

# Free AI mode (OpenAI-compatible API; docs/AI_ENRICHMENT.md#free-models). Same restart and
# re-analysis steps as above. Either a local model on this server (no key, no limits, slow on CPU):
# COMPOSE_PROFILES=local-llm                # starts the ollama container on the next deploy
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=gemma3:4b                       # pull it first: dc exec ollama ollama pull gemma3:4b
# LLM_TIMEOUT_SECONDS=600                   # CPU inference takes minutes per article
# ENRICH_CONCURRENCY=1
# OLLAMA_MEM_LIMIT=6g
# …or a hosted free tier (check its current limits and whether it trains on your data):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://<provider>/v1
# LLM_API_KEY=
# LLM_MODEL=<model id>
# LLM_REQUESTS_PER_MINUTE=10                # stay under the free tier's limit
# LLM_RESPONSE_FORMAT=json_schema           # or json_object / prompt if the API rejects it

# --- LLM cost controls (AI mode) -----------------------------------------------------------
LLM_MODEL=claude-sonnet-5
# hard daily cap; enrichment pauses when reached
LLM_DAILY_BUDGET_USD=2.00
ENRICH_MAX_PER_RUN=150
ENRICH_CONCURRENCY=4
# Stop starting calls after this many seconds per run (a slow local model must not hold up feeds)
ENRICH_MAX_SECONDS=600

# --- alerting ------------------------------------------------------------------------------
# Slack/Discord webhook or https://ntfy.sh/<topic>
ALERT_WEBHOOK_URL=
# slack | discord | ntfy | generic
ALERT_WEBHOOK_FORMAT=generic
# Optional dead-man checks (e.g. healthchecks.io, free): pinged after every pipeline run and
# every backup, with /fail appended on failure. They alert when the pings stop, which the
# webhook cannot do when the whole server is down. The GitHub monitor workflow does the same
# from outside, but GitHub stops scheduled workflows in repositories without activity.
HEALTHCHECK_PING_URL=
BACKUP_HEALTHCHECK_URL=

# --- pipeline ------------------------------------------------------------------------------
SCHEDULER_INTERVAL_MINUTES=15
LOG_LEVEL=INFO

# --- backups -------------------------------------------------------------------------------
BACKUP_DIR=/opt/gjurme/backups
BACKUP_HOUR_UTC=2
RETAIN_DAILY=7
RETAIN_WEEKLY=4
# RCLONE_REMOTE=b2:gjurme-backups        # with --profile offsite and ./rclone/rclone.conf
