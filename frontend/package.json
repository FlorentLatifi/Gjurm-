{
  "name": "gjurme-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "description": "GJURMË — Albanian & Balkan news intelligence dashboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:types": "openapi-typescript src/shared/api/openapi.json -o src/shared/api/schema.gen.ts",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:budget": "node scripts/budget.mjs",
    "check:api": "npm run api:types && git diff --exit-code -- src/shared/api/schema.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
