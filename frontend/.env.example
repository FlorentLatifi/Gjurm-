VITE_PUBLIC_URL=https://gjurme.example.com
# API base. Empty = same origin (Caddy serves the SPA and proxies /api).
VITE_API_BASE=
# Correction/removal contact on the About page: mailto:… (private) or https://…
# Empty = the repository's GitHub issues (public).
VITE_CONTACT_URL=
